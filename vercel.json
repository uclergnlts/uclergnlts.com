{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/demos/easing-visualizer",
      "destination": "/demos/spring-lab",
      "permanent": true
    },
    {
      "source": "/demos/audio-spectrum",
      "destination": "/demos/audio-reactive",
      "permanent": true
    },
    {
      "source": "/demos/aurora-borealis",
      "destination": "/lab",
      "permanent": true
    },
    {
      "source": "/demos/digital-rain",
      "destination": "/lab",
      "permanent": true
    },
    {
      "source": "/demos/gravity-field",
      "destination": "/lab",
      "permanent": true
    },
    {
      "source": "/demos/holographic-ui",
      "destination": "/lab",
      "permanent": true
    },
    {
      "source": "/demos/neural-interface",
      "destination": "/lab",
      "permanent": true
    },
    {
      "source": "/demos/parallax-stars",
      "destination": "/lab",
      "permanent": true
    },
    {
      "source": "/demos/shader-playground",
      "destination": "/lab",
      "permanent": true
    },
    {
      "source": "/demos/template",
      "destination": "/lab",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(fonts|me|projects|lab|appati|og|previews)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
